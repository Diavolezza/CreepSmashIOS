    "Selling returns 75 % of the prices paid. Building and upgrading take 2 seconds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkaufen bringt 75 % der bezahlten Preise zurück. Bauen und Upgrade dauern 2 Sekunden."
