    "Send %@ creeps" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schicke %@ Creeps"
          }
        }
      }
    },
    "Send a Fat Colossus" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schicke einen Fat Colossus"
          }
        }
      }
    },
    "Send creeps to your opponent's board. Every creep you send raises your income for good. If a creep reaches the end of the path, your opponent loses a life – and the creep starts again from the beginning." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schicke Creeps auf das Feld deines Gegners. Jeder geschickte Creep erhöht dein Einkommen dauerhaft. Erreicht ein Creep das Ende des Pfads, verliert der Gegner ein Leben – und der Creep läuft von vorn."
          }
        }
      }
    },
    "Send creeps to: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creeps an: %@"
          }
        }
      }
    },
