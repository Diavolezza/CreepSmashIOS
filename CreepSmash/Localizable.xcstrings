{
  "sourceLanguage" : "en",
  "strings" : {
    "" : {},
    "%@ / %@" : {
      "comment" : "A progress bar showing the current progress towards the next achievement tier. The first argument is the current progress value, which is capped at the next tier value. The second argument is the next tier value.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ has paused the game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ hat das Spiel angehalten."
